{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "pods.eks.amazonaws.com"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/eks-cluster-arn": "arn:aws:eks:HUB_REGION:HUB_ACCOUNT_ID:cluster/HUB_CLUSTER_NAME",
          "aws:RequestTag/kubernetes-namespace": "open-cluster-management-hub",
          "aws:RequestTag/kubernetes-service-account": "registration-controller-sa"
        }
      }
    }
  ]
}
