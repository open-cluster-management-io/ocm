{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "pods.eks.amazonaws.com"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/eks-cluster-arn": "arn:aws:eks:SPOKE_REGION:SPOKE_ACCOUNT_ID:cluster/SPOKE_CLUSTER_NAME",
          "aws:RequestTag/kubernetes-namespace": "open-cluster-management-agent",
          "aws:RequestTag/kubernetes-service-account": [
            "klusterlet-registration-sa",
            "klusterlet-work-sa"
          ]
        }
      }
    }
  ]
}
