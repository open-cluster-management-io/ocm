FROM golang:1.26-bookworm AS builder
ARG OS=linux
ARG ARCH=amd64
WORKDIR /go/src/open-cluster-management.io/ocm
COPY . .
ENV GO_PACKAGE open-cluster-management.io/ocm

RUN GOOS=${OS} \
    GOARCH=${ARCH} \
    GO_BUILD_PACKAGES=./cmd/registration \
    make build --warn-undefined-variables

RUN GOOS=${OS} \
    GOARCH=${ARCH} \
    GO_BUILD_PACKAGES=./cmd/server \
    make build --warn-undefined-variables

FROM registry.access.redhat.com/ubi9/ubi-minimal:latest
# zlib provides libz.so.1, required by the AWS CLI (mounted at /awscli via an
# initContainer) that the awsirsa registration driver spawns as an ExecCredential
# plugin. Without it the CLI crashes at process startup with:
#   error while loading shared libraries: libz.so.1: cannot open shared object file
RUN microdnf install -y zlib && microdnf clean all && rm -rf /var/cache/yum
ENV USER_UID=10001

COPY --from=builder /go/src/open-cluster-management.io/ocm/registration /
COPY --from=builder /go/src/open-cluster-management.io/ocm/server /

USER ${USER_UID}
